# Copy this file to ".env" and paste your own two values from Supabase.
#
# Where to find them: supabase.com -> your project -> Settings -> API
#   - "Project URL"                              -> EXPO_PUBLIC_SUPABASE_URL
#   - "Publishable" key (older name: anon public) -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# Use the PUBLISHABLE key, never the SECRET key (sb_secret_... / service_role).
# The secret key ignores the access rules in supabase/schema.sql and would be
# shipped inside the app on every phone.
#
# Leave them blank and the app still runs — it just keeps data on each phone
# separately instead of sharing it with the team.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
